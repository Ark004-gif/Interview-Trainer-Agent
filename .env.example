# ============================================================
#  IBM AICTE — Interview Trainer Agent  |  Environment Config
# ============================================================
# IMPORTANT: Rename this file to .env and fill in your credentials.
#            Never commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# IBM watsonx.ai (Granite LLM)
# Get these from: https://cloud.ibm.com → watsonx.ai service
# ------------------------------------------------------------
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID (IBM Cloud Lite — free tier)
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Alternative Granite models (uncomment to use):
# IBM_GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
# IBM_GRANITE_MODEL_ID=ibm/granite-20b-multilingual

# ------------------------------------------------------------
# IBM Watson Discovery (RAG Knowledge Retrieval)
# Get these from: IBM Cloud → Watson Discovery service
# ------------------------------------------------------------
IBM_WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
IBM_WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
IBM_WATSON_DISCOVERY_INSTANCE_ID=your_discovery_instance_id_here
IBM_WATSON_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# ------------------------------------------------------------
# IBM Watson Natural Language Understanding (NLU)
# Used for resume parsing and skill extraction
# ------------------------------------------------------------
IBM_WATSON_NLU_API_KEY=your_watson_nlu_api_key_here
IBM_WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False
APP_SECRET_KEY=change_this_to_a_random_secret_key_32chars

# ------------------------------------------------------------
# RAG / Vector Store Settings
# ------------------------------------------------------------
# Options: "chromadb" (local, default) | "watson_discovery" (IBM Cloud)
VECTOR_STORE_TYPE=chromadb
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=interview_knowledge_base

# ------------------------------------------------------------
# LLM Generation Parameters
# ------------------------------------------------------------
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_TOP_K=50
LLM_REPETITION_PENALTY=1.1

# ------------------------------------------------------------
# Interview Agent Settings
# ------------------------------------------------------------
MAX_QUESTIONS_PER_SESSION=15
DEFAULT_DIFFICULTY=intermediate
SUPPORTED_ROLES=Software Engineer,Data Scientist,Product Manager,DevOps Engineer,ML Engineer,Full Stack Developer,Backend Developer,Frontend Developer,Cloud Architect,Business Analyst
SUPPORTED_EXPERIENCE_LEVELS=fresher,junior,mid-level,senior,lead,principal

# ------------------------------------------------------------
# File Upload Settings
# ------------------------------------------------------------
MAX_RESUME_SIZE_MB=5
ALLOWED_RESUME_TYPES=pdf,docx,txt
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
